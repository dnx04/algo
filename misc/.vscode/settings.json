{
    "clangd.fallbackFlags": [
        "--std=c++20",
        "-Wall",
        "-Wextra",
        "-Warith-conversion",
        "-Wlogical-op",
        "-Wshift-overflow=2",
        "-Wduplicated-cond",
        "-Wcast-qual",
        "-Wcast-align",
        "-DLOCAL",
        "-fsanitize=address",
        "-fsanitize=undefined",
        "-fno-sanitize-recover",
        "-fstack-protector"
    ],
    "clangd.arguments": [
        "--clang-format-style=file:${workspaceFolder}/algo/.clang-format"
    ],
    "editor.tabSize": 2,
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
}
